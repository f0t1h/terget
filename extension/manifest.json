{
  "manifest_version": 3,
  "name": "terget",
  "version": "0.2.1",
  "description": "Right-click a link to copy a curl, wget or axel command that downloads it with your browser's cookies.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{e2af16d2-5902-4561-9007-7b57699f390f}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "minimum_chrome_version": "121",
  "permissions": ["contextMenus", "cookies", "clipboardWrite", "storage", "offscreen"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "terget",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
